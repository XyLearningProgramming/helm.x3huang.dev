# helmfile.yaml
helmDefaults:
  timeout: 3600
  wait: true
  atomic: true

# Environment-specific settings
environments:
  default:
    values:
      - values/default.yaml.gotmpl
  prod:
    values:
      - values/prod.yaml.gotmpl
---
# Repositories
repositories:
  - name: jetstack
    url: https://charts.jetstack.io
  - name: prometheus-community
    url: https://prometheus-community.github.io/helm-charts
  - name: docker-mailserver
    url: https://docker-mailserver.github.io/docker-mailserver-helm/
  - name: grafana
    url: https://grafana.github.io/helm-charts
  - name: mittwald
    url: https://helm.mittwald.de
  - name: bitnami
    url: https://charts.bitnami.com/bitnami
  - name: stakater
    url: https://stakater.github.io/stakater-charts
---
releases:
# Traefik is owned by k3s (HelmChart + HelmChartConfig in kube-system).
# Do not manage it here. See traefik/README.md.

# Replicator: copy tls secrets to different ns
  - name: kubernetes-replicator
    namespace: kube-system                # where you want the controller to live
    chart: mittwald/kubernetes-replicator
    version: "2.12.6"                     # pin to a specific chart version if you like
    values:
      - resources:
          limits:
            cpu: 50m
            memory: 64Mi
          requests:
            cpu: 5m
            memory: 8Mi
        args:
          - -resync-period=5m

# Reloader: restart pods when their mounted Secrets change (e.g. after TLS renewal)
  - name: reloader
    namespace: kube-system
    chart: stakater/reloader
    version: "2.2.21"
    values:
      - reloader:
          watchGlobally: true
          deployment:
            resources:
              requests:
                cpu: 5m
                memory: 8Mi
              limits:
                cpu: 30m
                memory: 64Mi

# Cert-Manager Chart
  - name: cert-manager
    namespace: cert-manager
    chart: jetstack/cert-manager
    version: v1.20.5
    needs:
      - kube-system/kubernetes-replicator
    installed: true
    values:
      # Chart v1.20.x has a strict values schema; do not pass the shared
      # environment values (DOMAIN, *_NODE, ...) that cert-manager does not consume.
      - namespace: cert-manager
      - resources:
          limits:
            cpu: "200m"  # (0.2 vCPU)
            memory: "128Mi"
          requests:
            cpu: 5m
            memory: 8Mi
      - webhook:
          resources:
            limits:
              cpu: "50m"
              memory: "64Mi"
            requests:
              cpu: 5m
              memory: 8Mi
      - cainjector:
          resources:
            limits:
              cpu: "100m"
              memory: "192Mi"
            requests:
              cpu: 5m
              memory: 16Mi
    set:
      # one time install crd first
      # kubectl apply -f https://github.com/cert-manager/cert-manager/releases/download/v1.20.5/cert-manager.crds.yaml
      - name: crds.enabled
        value: false
      - name: prometheus.enabled
        value: false
      - name: webhook.timeoutSeconds
        value: 10

# Ingress Settings
  - name: ingress
    chart: ./ingress-cert
    namespace: cert-manager
    needs:
      - cert-manager/cert-manager
    values:
      - values/{{ .Environment.Name }}.yaml.gotmpl
    set:
      - name: Environment
        value: {{ .Environment.Name }}

# Backend namespace: TLS secret replication
  - name: backend
    namespace: backend
    chart: ./backend
    needs:
      - cert-manager/ingress
    values:
      - values/{{ .Environment.Name }}.yaml.gotmpl

# Dummy Service
  - name: dummy-page
    namespace: default
    chart: ./dummy-page
    needs:
      - cert-manager/ingress
    values:
      - values/{{ .Environment.Name }}.yaml.gotmpl
      - namespace: default

# Mail: persistent storage 
  - name: mail-storage
    namespace: mail
    chart: ./mail-storage
    values:
      - values/{{ .Environment.Name }}.yaml.gotmpl

# Prometheus stack
  - name: kube-prom-stack
    namespace: monitoring
    chart: prometheus-community/kube-prometheus-stack
    version: "93.9.0"
    # install crds
    # 
    # ref: https://artifacthub.io/packages/helm/prometheus-community/kube-prometheus-stack/10.0.1
    # 
    # kubectl apply -f https://github.com/prometheus-operator/prometheus-operator/releases/download/v0.95.2/stripped-down-crds.yaml
    #
    # kubectl apply -f https://raw.githubusercontent.com/prometheus-operator/prometheus-operator/release-0.95/example/prometheus-operator-crd/monitoring.coreos.com_alertmanagers.yaml
    # kubectl apply -f https://raw.githubusercontent.com/prometheus-operator/prometheus-operator/release-0.95/example/prometheus-operator-crd/monitoring.coreos.com_podmonitors.yaml
    # kubectl apply -f https://raw.githubusercontent.com/prometheus-operator/prometheus-operator/release-0.95/example/prometheus-operator-crd/monitoring.coreos.com_prometheuses.yaml
    # kubectl apply -f https://raw.githubusercontent.com/prometheus-operator/prometheus-operator/release-0.95/example/prometheus-operator-crd/monitoring.coreos.com_prometheusrules.yaml
    # kubectl apply -f https://raw.githubusercontent.com/prometheus-operator/prometheus-operator/release-0.95/example/prometheus-operator-crd/monitoring.coreos.com_servicemonitors.yaml
    # kubectl apply -f https://raw.githubusercontent.com/prometheus-operator/prometheus-operator/release-0.95/example/prometheus-operator-crd/monitoring.coreos.com_thanosrulers.yaml
    # kubectl apply -f https://raw.githubusercontent.com/prometheus-operator/prometheus-operator/release-0.95/example/prometheus-operator-crd/monitoring.coreos.com_probes.yaml
    values:
      - values/{{ .Environment.Name }}.yaml.gotmpl
      - prom-stack/values.yaml.gotmpl
    set:
      - name: crds.enabled
        value: false

# Redis stack
  - name: redis
    namespace: db
    chart: bitnami/redis
    version: "28.3.16"
    needs:
      - db/db-storage
    values:
      - values/{{ .Environment.Name }}.yaml.gotmpl
      - db/redis.values.yaml.gotmpl

# Mail Server
  - name: mailserver
    namespace: mail
    chart: docker-mailserver/docker-mailserver
    version: 6.0.0
    # Mail ingresses use the standard Ingress resource (ingressClassName:
    # traefik). Traefik itself is owned by k3s — its CRDs ship with the
    # bundled traefik-crd HelmChart; no manual CRD applies are needed.
    needs:
      - cert-manager/cert-manager
      - kube-system/reloader
      - mail/mail-storage
      - db/redis
    values:
      - values/{{ .Environment.Name }}.yaml.gotmpl
      - mail/values.yaml.gotmpl

# Loki stack
  - name: loki-stack
    namespace: monitoring
    chart: grafana/loki-stack
    version: "2.10.3"
    values:
      - values/{{ .Environment.Name }}.yaml.gotmpl
      - loki-stack/values.yaml.gotmpl

# DB: persistent storage 
  - name: db-storage
    namespace: db
    chart: ./db-storage
    values:
      - values/{{ .Environment.Name }}.yaml.gotmpl

# Postgres stack
  - name: postgres
    namespace: db
    chart: bitnami/postgresql
    version: 16.7.11    
    needs:
      - db/db-storage
    values:
      - values/{{ .Environment.Name }}.yaml.gotmpl
      - db/postgres.values.yaml.gotmpl

# Free protocols
  - name: free
    namespace: free
    chart: ./free
    needs:
      - cert-manager/ingress
      - kube-system/reloader
    values:
      - values/{{ .Environment.Name }}.yaml.gotmpl
      - free/values.yaml.gotmpl
